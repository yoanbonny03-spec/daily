# ============================================================
#  .env.example — скопируй в .env и заполни своими значениями
# ============================================================

# ---- AmoCRM ----

# Субдомен твоего AmoCRM (например: myschool → myschool.amocrm.ru)
AMO_DOMAIN=myschool

# Долгосрочный access token из интеграции AmoCRM (OAuth2)
# Как получить: Настройки → Интеграции → создай интеграцию, скопируй токен
AMO_ACCESS_TOKEN=your_amo_access_token_here

# ID кастомных полей лида — узнать можно через:
#   GET https://{domain}.amocrm.ru/api/v4/leads/custom_fields
# или запустить: python helper_find_field_ids.py

# ID поля "Город"
AMO_CITY_FIELD_ID=123456

# ID поля "Отдел" (Онлайн / Оффлайн)
AMO_DEPARTMENT_FIELD_ID=123457

# ID поля "Дата окончания занятий"
AMO_END_DATE_FIELD_ID=123458

# Названия воронок для новых продаж (JSON-массив или через запятую)
# Убедись что названия точно совпадают с названиями воронок в AmoCRM
AMO_SALES_PIPELINE_NAMES=["Оффлайн"]

# Названия воронок для Expires
AMO_EXPIRES_PIPELINE_NAMES=["Ежемесячники (1 месяц)","Абонементы (3-6 месяцев)","До конца учебного года (7-12 месяцев)"]

# ID статусов «Договор подписан / Успешно реализовано» (JSON-массив)
# Найди через: GET /api/v4/leads/pipelines
# или запусти: python helper_find_field_ids.py
AMO_WON_STATUS_IDS=[142, 143]

# ---- Фильтры ----
CITY_VALUE=Астана
DEPARTMENT_VALUE=Оффлайн

# ---- Google Sheets ----

# Путь к JSON-файлу сервисного аккаунта Google
# Как создать: console.cloud.google.com → IAM → Сервисные аккаунты → создать ключ JSON
# Затем выдай этому аккаунту доступ к обеим таблицам (редактор)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ID таблицы с оплатами сотрудников (и листом "План еженедельный")
# Берётся из URL: docs.google.com/spreadsheets/d/ВОТ_ЭТО_ID/edit
PAYMENT_SPREADSHEET_ID=13VSSDS3fb545dZIugpx_buRHNPON5dihX4YZuVpU-o4

# ID таблицы ежедневного отчёта (куда пишем результаты)
REPORT_SPREADSHEET_ID=ВОТ_ЭТО_ID_ТАБЛИЦЫ_ОТЧЁТА

# Название листа в таблице отчёта
REPORT_SHEET_NAME=Февраль заполнение

# Столбцы в таблице отчёта (оставь как есть, если структура стандартная)
REPORT_CITY_COL=A
REPORT_DATE_COL=B
